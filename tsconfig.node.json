{
  /*
   * IMPORTANCIA: valida los archivos de configuración que se ejecutan en Node.
   * Separarlo de tsconfig.app.json aplica separación de responsabilidades; las
   * opciones concretas de Node/Vite no constituyen un patrón de negocio.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Resolución de módulos para el entorno de herramientas. */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Reglas que impiden variables o parámetros accidentales. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
