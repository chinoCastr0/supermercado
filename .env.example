# Copiar a .env (raíz, ignorado por Git) y reemplazar los valores antes de
# `docker compose up`. Postgres sólo aplica POSTGRES_PASSWORD al crear el
# volumen por primera vez: cambiarlo después no rota una contraseña ya
# inicializada. Conservar la contraseña actual.
POSTGRES_DB=reemplazar_nombre_base
POSTGRES_USER=reemplazar_usuario
POSTGRES_PASSWORD=reemplazar_password
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Usar credenciales del volumen existente. No copiar este archivo sobre .env.
# Compose fija POSTGRES_HOST=database y POSTGRES_PORT=5432; no usa DATABASE_URL local.
# Las claves de Clerk deben pertenecer a la misma aplicación que el frontend.
CLERK_SECRET_KEY=sk_live_reemplazar
ALLOWED_ORIGINS=https://supermercado.leacastro.dev
# Dominio de producción en Vercel, sin barra final. No incluir localhost aquí.
# El código conserva defaults de localhost únicamente para desarrollo sin esta variable.
# Varios orígenes: separados por comas, sin rutas. También valida Clerk azp.

# Subdominio público de la API, sin https:// ni barra final; DNS dirigido al VPS.
API_SERVER_NAME=api.supermercado.leacastro.dev
# Correo de contacto para Let's Encrypt.
LETSENCRYPT_EMAIL=admin@example.com

# Publishable Key de la app en el dashboard de Clerk (clerk.com > API Keys).
# Empieza con pk_ y no es secreta: Vite la incluye en el bundle del frontend.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_reemplazar
