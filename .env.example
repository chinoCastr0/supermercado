# Copiar a .env (raíz, ignorado por Git) y reemplazar los valores antes de
# `docker compose up`. Postgres sólo aplica POSTGRES_PASSWORD al crear el
# volumen por primera vez: cambiarlo después no rota una contraseña ya
# inicializada (usar ALTER ROLE para eso).
POSTGRES_DB=supermercado
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-before-first-run

# Publishable Key de la app en el dashboard de Clerk (clerk.com > API Keys).
# Empieza con pk_ y no es secreta: Vite la incluye en el bundle del frontend.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_reemplazar
