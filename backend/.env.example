# Desarrollo local del backend fuera de Docker.
DATABASE_URL=postgresql://admin:desarrollo@localhost:5433/supermercado
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret Key de la aplicación en el dashboard de Clerk (clerk.com > API Keys).
# Nunca commitear el valor real; sólo vive en el .env local (ignorado por Git).
CLERK_SECRET_KEY=sk_test_reemplazar

# Referencia de los campos de conexión; el código actual sólo lee DATABASE_URL.
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=supermercado
# DB_USER=admin
# DB_PASSWORD=desarrollo
