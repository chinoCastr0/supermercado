# Desarrollo local del backend fuera de Docker.
DATABASE_URL=postgresql://admin:desarrollo@localhost:5433/supermercado
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret Key de la aplicación en el dashboard de Clerk (clerk.com > API Keys).
# Nunca commitear el valor real; sólo vive en el .env local (ignorado por Git).
CLERK_SECRET_KEY=sk_test_reemplazar

# Alternativa a DATABASE_URL. Si POSTGRES_HOST está definido, estos campos prevalecen.
# Docker Compose los inyecta automáticamente usando POSTGRES_* del .env raíz.
# Sin ports en database, localhost:5433 requiere un túnel/publicación local.
# POSTGRES_HOST=database
# POSTGRES_PORT=5432
# POSTGRES_DB=reemplazar_nombre_base
# POSTGRES_USER=reemplazar_usuario
# POSTGRES_PASSWORD=reemplazar_password
# database solo se resuelve dentro de la red Compose. Fuera de Docker, usar
# DATABASE_URL con un host/puerto accesible y credenciales codificadas en la URL.
